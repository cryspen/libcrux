proofs/

# Track the SIMD intrinsics trust-index (generated by
# scripts/intrinsics-audit.py; reproducible from sources) and
# sprint deliverables.
!proofs/
proofs/*
!proofs/intrinsics-trust-index.md
!proofs/intrinsics-trust-index.csv
!proofs/intrinsics-cross-validation-findings.md
!proofs/sprint-status-*.md
!proofs/sprint-phaseB-summary.md
!proofs/nospec-classification.md

# Track the canonical hand-written intrinsics lane-view + op-lemma companion
# (Option B, Phase 1).  It has NO Rust source, so `hax.py extract` never
# regenerates it (mirrors the tracked, hand-written Tactics.Circuits.fst).  It is
# on the F* include path of ml-kem / ml-dsa / sha3.  Everything else under
# proofs/fstar/extraction stays ignored (hax-generated).
!proofs/fstar
proofs/fstar/*
!proofs/fstar/extraction
proofs/fstar/extraction/*
!proofs/fstar/extraction/Libcrux_core_models.Intrinsics_views.fst
# THE trusted intrinsics axioms (hand-written; audit entry point).
!proofs/fstar/extraction/Libcrux_core_models.Trusted.Intrinsics.fst
# NEON op-lemma companion (hand-written; ARM analog of Intrinsics_views).
!proofs/fstar/extraction/Libcrux_core_models.Neon_views.fst
